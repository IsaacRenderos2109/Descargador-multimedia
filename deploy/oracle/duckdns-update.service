[Unit]
Description=Update the Video Downloader DuckDNS record
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=duckdns
Group=duckdns
EnvironmentFile=/etc/video-downloader/duckdns.env
ExecStart=/usr/bin/python3 /opt/video-downloader/deploy/oracle/duckdns_update.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6
